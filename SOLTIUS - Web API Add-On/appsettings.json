{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5006",
  "Jwt": {
    "Issuer": "SOLTIUS.WebApi",
    "Audience": "SOLTIUS.CustomApi",
    "SigningKey": "${JWT_SIGNING_KEY}",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "Clients": [
      {
        "ClientId": "scheduler-addon",
        "ClientSecret": "${CLIENT_SECRET}",
        "DisplayName": "SOLTIUS Scheduler Add-On"
      }
    ]
  },
  "Scheduler": {
    "MaxRetryCount": 5
  },
  "ConnectionStrings": {
    "MySqlConnection": "server=${STAGING_DB_SERVER};database=${STAGING_DB_NAME};uid=${STAGING_DB_USER};pwd=${STAGING_DB_PASS};"
  },
  "LogDatabase": {
    "Server": "${LOG_DB_SERVER}",
    "DatabaseName": "${LOG_DB_NAME}",
    "UserName": "${LOG_DB_USER}",
    "Password": "${LOG_DB_PASS}"
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  }
}