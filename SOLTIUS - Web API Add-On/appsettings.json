{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5006",
  "Jwt": {
    "Issuer": "SOLTIUS.WebApi",
    "Audience": "SOLTIUS.CustomApi",
    "SigningKey": "${JWT_SIGNING_KEY}",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "Clients": [
      {
        "ClientId": "scheduler-addon",
        "ClientSecret": "${CLIENT_SECRET}",
        "DisplayName": "SOLTIUS Scheduler Add-On"
      }
    ]
  },
  "Scheduler": {
    "MaxRetryCount": 5
  },
  "ConnectionStrings": {
    "MySqlConnection": "server=REDACTED;database=test;uid=REDACTED;pwd=REDACTED;"
  },
  "LogDatabase": {
    "Server": "REDACTED",
    "DatabaseName": "log",
    "UserName": "REDACTED",
    "Password": "REDACTED"
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  }
}
